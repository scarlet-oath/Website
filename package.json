{
    "name": "scarlet-oath",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "preinstall": "node scripts/check-node-version.mjs",
        "check:node": "node scripts/check-node-version.mjs",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "lucide-react": "^1.71.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "simple-icons": "^16.37.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.6",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "jsdom": "^31.0.0",
        "tailwindcss": "^4.3.5",
        "typescript": "~7.0.2",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    }
}
