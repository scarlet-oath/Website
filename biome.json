{
    "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
    "files": {
        "includes": ["**", "!**/dist", "!**/coverage", "!**/node_modules", "!**/.idea", "!package-lock.json"],
        "ignoreUnknown": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "asNeeded",
            "bracketSpacing": false,
            "trailingCommas": "all"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "useValidAnchor": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/*.svg"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noSvgWithoutTitle": "off"
                    }
                }
            }
        }
    ],
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}
